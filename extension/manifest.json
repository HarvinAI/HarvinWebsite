{
  "manifest_version": 3,
  "name": "HarvinAI — D2C Brand & Tech Intelligence",
  "short_name": "HarvinAI",
  "description": "Detect any website's tech stack, classify D2C brands, track funding signals & discover 500K+ accounts.",
  "version": "1.3.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Scan this website with HarvinAI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "<all_urls>"
  ],
  "homepage_url": "https://www.harvin.ai",
  "offline_enabled": false
}
