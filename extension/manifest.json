{
  "manifest_version": 3,
  "name": "TechScanner by Harvin AI",
  "description": "Instantly detect any website's tech stack — ecommerce platform, analytics, payments, frameworks & more.",
  "version": "1.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": [
    "https://www.harvin.ai/*",
    "https://harvin.ai/*"
  ]
}
